# ============================================================
# AI Customer Service — Environment Variables
# Copy to .env and fill in your values.
# ============================================================

# --- LLM (OpenAI-compatible interface) ---
# Supports any OpenAI-compatible provider: DeepSeek, vLLM, LM Studio, Groq, etc.
LLM_PROVIDER=openai_compat
LLM_MODEL=deepseek-chat
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
# Leave LLM_BASE_URL empty to use official OpenAI endpoint
# For official OpenAI: LLM_PROVIDER=openai, LLM_MODEL=gpt-4o, LLM_BASE_URL=
# For Anthropic: LLM_PROVIDER=anthropic, LLM_MODEL=claude-sonnet-4-6
# For Ollama: LLM_PROVIDER=ollama, LLM_MODEL=llama3.2, OLLAMA_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.0
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Embedding (OpenAI-compatible) ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=sk-your-embedding-api-key-here
EMBEDDING_BASE_URL=
# Use same key as LLM if provider supports embeddings

# --- PostgreSQL ---
POSTGRES_URL=postgresql+asyncpg://csuser:cspass@localhost:5432/customer_service
# For Docker Compose internal networking:
# POSTGRES_URL=postgresql+asyncpg://csuser:cspass@postgres:5432/customer_service
POSTGRES_POOL_SIZE=10

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
# For Docker Compose: REDIS_URL=redis://redis:6379/0

# --- Langfuse (Observability) ---
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com
# Self-hosted: LANGFUSE_HOST=http://langfuse:3000

# --- RAG ---
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-base
RETRIEVAL_K=5

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

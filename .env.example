# ─── LLM (OpenAI 兼容接口，支持 DeepSeek / vLLM / LM Studio 等) ────────────
LLM_PROVIDER=openai_compat
LLM_MODEL=deepseek-chat
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.deepseek.com/v1   # 留空则使用官方 OpenAI

# ─── Embedding ───────────────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=                          # 留空则复用 LLM_API_KEY
EMBEDDING_BASE_URL=                         # 留空则复用 LLM_BASE_URL

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_URL=postgresql+asyncpg://csuser:cspass@localhost:5432/customer_service
POSTGRES_POOL_SIZE=10

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Langfuse (可观测性，留空则禁用) ─────────────────────────────────────────
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── RAG ─────────────────────────────────────────────────────────────────────
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-base
RETRIEVAL_K=5

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ─── JWT Authentication ───────────────────────────────────────────────────────
# 留空 = 开放模式（访客，无需登录）。生产环境必须配置其中一种。
#
# 方案 A：HS256 对称密钥（自托管，推荐入门）
#   生成命令：openssl rand -hex 32
# JWT_SECRET=your-very-long-random-secret-at-least-32-chars
# JWT_ALGORITHM=HS256
# JWT_REQUIRED=false      # true 则强制所有连接必须携带 token
#
# 方案 B：RS256/ES256 JWKS（接入第三方 IdP，推荐生产）
#   Auth0:    JWT_JWKS_URL=https://your-tenant.auth0.com/.well-known/jwks.json
#   Keycloak: JWT_JWKS_URL=https://sso.example.com/realms/{realm}/protocol/openid-connect/certs
#   Authing:  JWT_JWKS_URL=https://your-app.authing.cn/oidc/.well-known/jwks.json
#   Casdoor:  JWT_JWKS_URL=https://your-casdoor.example.com/.well-known/jwks
# JWT_JWKS_URL=
# JWT_ALGORITHM=RS256
# JWT_ISSUER=https://your-idp.example.com/   # 可选，验证 iss claim
# JWT_AUDIENCE=yuanmeng-cs                   # 可选，验证 aud claim
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_JWKS_URL=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_REQUIRED=false

# ─── Data Sources ─────────────────────────────────────────────────────────────
# 每个数据源独立配置：SOURCE_TYPE = internal_db（默认）| rest_api
# AUTH 类型：none | api_key | bearer | oauth2 | basic
#
# ── 订单数据源（OMS / ERP 集成，如 Shopify、自研 OMS、NetSuite）──────────────
ORDER_SOURCE_TYPE=internal_db
ORDER_SOURCE_URL=
# ORDER_SOURCE_URL=https://oms.example.com/api/v1

ORDER_SOURCE_AUTH=none
# --- API Key 认证示例 ---
# ORDER_SOURCE_AUTH=api_key
# ORDER_SOURCE_API_KEY=your-api-key-here
# ORDER_SOURCE_API_KEY_HEADER=X-API-Key

# --- Bearer Token 认证示例 ---
# ORDER_SOURCE_AUTH=bearer
# ORDER_SOURCE_BEARER_TOKEN=your-bearer-token

# --- OAuth2 Client Credentials 认证示例（Shopify / NetSuite / Salesforce）---
# ORDER_SOURCE_AUTH=oauth2
# ORDER_SOURCE_OAUTH2_TOKEN_URL=https://auth.example.com/oauth/token
# ORDER_SOURCE_OAUTH2_CLIENT_ID=your-client-id
# ORDER_SOURCE_OAUTH2_CLIENT_SECRET=your-client-secret
# ORDER_SOURCE_OAUTH2_SCOPE=orders:read orders:write

# --- Basic Auth 认证示例 ---
# ORDER_SOURCE_AUTH=basic
# ORDER_SOURCE_BASIC_USER=api_user
# ORDER_SOURCE_BASIC_PASS=api_password

ORDER_SOURCE_TIMEOUT=30.0

# ── 商品目录数据源（PIM / 电商平台同步，如 Akeneo、Shopify Products）─────────
# 当 TYPE=rest_api 时，系统在启动时自动从外部 API 同步商品数据到本地 faq_documents 表
PRODUCT_SOURCE_TYPE=internal_db
PRODUCT_SOURCE_URL=
PRODUCT_SOURCE_AUTH=none
# PRODUCT_SOURCE_API_KEY=
# PRODUCT_SOURCE_BEARER_TOKEN=
PRODUCT_SOURCE_TIMEOUT=60.0

# ── FAQ 知识库数据源（CMS / Zendesk / Notion / Confluence 同步）─────────────
# 当 TYPE=rest_api 时，系统在启动时自动从外部知识库同步 FAQ 到本地
FAQ_SOURCE_TYPE=internal_db
FAQ_SOURCE_URL=
FAQ_SOURCE_AUTH=none
# FAQ_SOURCE_API_KEY=
# FAQ_SOURCE_BEARER_TOKEN=
FAQ_SOURCE_TIMEOUT=60.0
